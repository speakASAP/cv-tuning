NODE_ENV=development
PORT=3379

# Required — the service refuses to start without a database.
CV_DATABASE_URL=postgresql://cv_app:CHANGEME@localhost:5432/cv

AUTH_SERVICE_URL=http://localhost:3370
# Optional. Offboarding reconciliation calls auth's internal existence route. A GET of
# `${AUTH_USER_LOOKUP_URL}/<userId>` is read as 200=exists, 404=confirmed-gone, else unresolved.
# AUTH_USER_LOOKUP_URL=http://localhost:3370/internal/users
# AUTH_USER_LOOKUP_TOKEN=
# AUTH_USER_LOOKUP_SERVICE_NAME=cv-tuning
AI_SERVICE_URL=http://localhost:3380
# ServiceAuthGuard on /ai/complete verifies HS256 against this shared secret.
JWT_SECRET=CHANGEME
LOGGING_SERVICE_URL=http://localhost:3367
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGEME
MINIO_SECRET_KEY=CHANGEME
MINIO_BUCKET=cv-uploads
